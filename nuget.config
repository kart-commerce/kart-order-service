<?xml version="1.0" encoding="utf-8"?>
<!--
  "packages/" vendors the Kart.Shared.* NuGet packages (built from kart-shared via `dotnet pack`).
  kart-shared has no published feed yet - a project reference across repos would break this
  service's standalone Docker build, so the packed .nupkg files are vendored here instead,
  keeping this repo self-contained for restore/build/CI/Docker (same pattern as
  kart-payment-service / kart-identity-service).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="kart-shared-local" value="packages" />
  </packageSources>
</configuration>
