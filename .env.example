# Copy to .env (gitignored) and fill in real values for your machine.
# scripts/migrate.sh and scripts/seed-orders.sh load this automatically — only needed if your
# local Postgres differs from OrderDbContextFactory's localhost/postgres/postgres default.
# Keep the quotes: migrate.sh sources this file with bash, and an unquoted ";" in the connection
# string is parsed as a command separator, silently truncating it.
ORDER_DB_CONNECTION_STRING="Host=localhost;Port=5433;Database=kart_order;Username=postgres;Password=postgres"
